# ─── Atlas proxy — environment overrides ──────────────────────────────────────
# Copy to `.env` and edit.  All values are optional; sensible defaults apply.
# Every var is read on proxy start, so changes take effect after a restart.

# ─── Server ────────────────────────────────────────────────────────────────────
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8788

# ─── Provider selection ────────────────────────────────────────────────────────
# Determines which upstream the proxy talks to on boot.  The ``atlas`` CLI
# writes data/proxy_data/runtime_provider.json to flip this without an env
# edit; ATLAS_PROVIDER is the fallback.
# ATLAS_PROVIDER=openrouter            # or "huggingface"

# ─── Default model ─────────────────────────────────────────────────────────────
# ATLAS_OPENROUTER_MODEL=z-ai/glm-5.2:free
# ATLAS_HF_MODEL=deepseek-ai/DeepSeek-V4-Flash:deepinfra
# FORCE_DEFAULT_MODEL=1                  # 1=replace client model, 0=pass through
# FORCE_DEFAULT_MODEL_OR=                # per-provider override (optional)
# FORCE_DEFAULT_MODEL_HF=

# ─── Upstream URLs (override only if you proxy through a mirror) ────────────────
# ATLAS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ATLAS_HF_BASE_URL=https://router.huggingface.co/v1

# ─── Key files ─────────────────────────────────────────────────────────────────
# Override paths if you keep keys outside the bundled data/ tree.
# ATLAS_OPENROUTER_KEYS_FILE=
# ATLAS_HF_KEYS_FILE=
# ATLAS_HF_DEAD_KEYS_FILE=

# ─── System prompt override (hot-reload on file mtime change) ──────────────────
# SYSTEM_PROMPT_OVERRIDE_ENABLED=1
# SYSTEM_PROMPT_OVERRIDE_FILE=data/proxy_data/prompt_override.txt
# SYSTEM_PROMPT_REINFORCEMENT_ENABLED=0
# SYSTEM_PROMPT_STRIP_HARNESS=1

# ─── Connection pool / timeouts ────────────────────────────────────────────────
# MAX_CONNECTIONS=200
# MAX_KEEPALIVE_CONNECTIONS=100
# KEEPALIVE_EXPIRY=60
# CONNECT_TIMEOUT=15
# ATLAS_PROXY_READ_TIMEOUT=600
# WRITE_TIMEOUT=300
# POOL_TIMEOUT=30

# ─── Key health / retry ────────────────────────────────────────────────────────
# ATLAS_PROXY_COOLDOWN_SECONDS=45
# COOLDOWN_MAX_SECONDS=300
# ATLAS_PROXY_MAX_ERRORS=8
# ATLAS_PROXY_SUSPEND_SECONDS=600
# HEALTH_CHECK_INTERVAL=60
# PREWARM_INTERVAL=300
# ATLAS_PROXY_MAX_RETRIES=5
# STREAM_FIRST_BYTE_TIMEOUT=20
# ATLAS_PROXY_KEEPALIVE_SECONDS=15
# FREE_MODEL_MAX_CONCURRENT=25
# ATLAS_PROXY_MAX_CONCURRENT_PER_KEY=24
# ATLAS_PROXY_STICKY_MAX_USES=18

# ─── Context window / response size ────────────────────────────────────────────
# ATLAS_PROXY_MAX_INPUT_TOKENS=180000
# MAX_TOKEN_TRIM_KEEP_SYSTEM=1
# ATLAS_MODEL_CONTEXT_WINDOW=200000
# ATLAS_MAX_RESPONSE_BYTES=0            # 0 = unlimited

# ─── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_JSON=0
# LOG_REQUEST_ID=1
# ATLAS_LOG_FILE=                        # default: <repo>/proxy/logs/atlas-proxy.log
# ATLAS_LOG_FILE_MAX_BYTES=10485760
# ATLAS_LOG_FILE_BACKUPS=3
# ATLAS_LOG_COLOR=auto                   # auto|always|never
# ATLAS_TTFT_GOOD_MS=1500
# ATLAS_TTFT_BAD_MS=4000
# ATLAS_TOTAL_GOOD_S=10
# ATLAS_TOTAL_BAD_S=30
# ATLAS_TPS_GOOD=100
# ATLAS_TPS_BAD=30
# ATLAS_LOG_VERBOSE=0

# ─── CORS / upstream identity ──────────────────────────────────────────────────
# CORS_ORIGINS=*
# ATLAS_UPSTREAM_REFERER=https://localhost:8788
# ATLAS_UPSTREAM_TITLE=Atlas-Translation-Proxy

# ─── Payload debugging ─────────────────────────────────────────────────────────
# ATLAS_SAVE_PAYLOAD_FILES=0             # write inbound payloads to disk
# ATLAS_PAYLOAD_DIR=                      # default: <repo>/data/payloads